# --- OpenAI ---
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional override, defaults to gpt-4o if unset
OPENAI_MODEL=gpt-4o

# --- Twilio ---
# Found in the Twilio Console dashboard (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACyour-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
# Only needed by configure_twilio.py to point a number at this server
TWILIO_PHONE_NUMBER=+15551234567

# --- App config ---
# Public HTTPS base URL Twilio uses to reach this server (your ngrok URL
# while developing, e.g. https://abcd1234.ngrok-free.app). Must match the
# request URL Twilio actually calls, since it's used for signature checks.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# Set to "false" only for local testing without a real Twilio signature
# (e.g. curl testing). Keep "true" in production.
VALIDATE_TWILIO_SIGNATURE=true

# --- Government welfare API (government_api/welfare_api.py) ---
# "mock" (default) uses a curated local catalog -- no credentials needed,
# and it's what the /test-call demo runs against out of the box. "live" is
# a placeholder for real Bokjiro / Inclusive Finance Agency / Wello calls
# once you have institutional API access; see _fetch_live() in that file.
WELFARE_API_MODE=mock
WELFARE_API_BASE_URL=
WELFARE_API_KEY=

# --- Officer email notification (approval/notifier.py) ---
# All optional -- if any are unset, the pipeline just skips emailing the
# officer (logged, not an error) and the approval dashboard on /test-call
# still works without them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
OFFICER_EMAIL=officer@example.gov
